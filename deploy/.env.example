# =====================================================================================
#  НАСТРОЙКИ СЕРВЕРА — единственный файл, который нужно заполнить для запуска магазина.
#
#  1. Скопируйте:  cp deploy/.env.example deploy/.env
#  2. Заполните строки под пометкой «← ОБЯЗАТЕЛЬНО» (остальные можно не трогать)
#  3. Запуск: см. docs/13-Публикация-на-сервере.md; все переменные — docs/23-Переменные-окружения.md
#
#  deploy/.env хранит пароли — он НЕ попадает в git (.gitignore) и не отдаётся сайтом.
#  Если что-то заполнено неправильно, сервер не запустится и напишет, что исправить:
#      docker compose --env-file deploy/.env -f deploy/docker-compose.yml logs backend
#
#  Для запуска на своём компьютере этот файл НЕ НУЖЕН (всё работает по умолчанию).
# =====================================================================================

# --- Домен ----------------------------------------------------------------------------
# домен магазина без https:// и www. Сайт, API (/api) и фото (/media) — на этом домене
# ← ОБЯЗАТЕЛЬНО
DOMAIN=kbeauty-chealth.kz
# почта для писем Let's Encrypt (окончание сертификата HTTPS)
# ← ОБЯЗАТЕЛЬНО
LETSENCRYPT_EMAIL=owner@gmail.com

# --- Секретный ключ ------------------------------------------------------------------------
# случайная строка ≥ 32 символов. Получить:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ← ОБЯЗАТЕЛЬНО
SECRET_KEY=

# --- База данных PostgreSQL (создаётся сама при первом запуске) --------------------------
POSTGRES_DB=kbch
POSTGRES_USER=kbch
# пароль базы: только латинские буквы и цифры, 24+ символа. База не доступна из интернета
# ← ОБЯЗАТЕЛЬНО
POSTGRES_PASSWORD=
# резервные копии базы и фото: каждый день в deploy/backups/, хранятся столько дней
BACKUP_KEEP_DAYS=14

# --- Администратор (один) --------------------------------------------------------------------
# Аккаунт создаётся при запуске; чтобы сменить пароль — поменяйте здесь и перезапустите:
#     docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d backend
# ← ОБЯЗАТЕЛЬНО
ADMIN_EMAIL=
ADMIN_NAME=Администратор
# Вариант 1: пароль (≥ 12 символов)
# ← ОБЯЗАТЕЛЬНО (или вариант 2)
ADMIN_PASSWORD=
# Вариант 2 (надёжнее): вместо пароля — его хеш, тогда пароль нигде не хранится открыто.
# Получить:  docker compose --env-file deploy/.env -f deploy/docker-compose.yml run --rm backend python -m app.cli hash-password
# Вставьте в одинарных кавычках, а ADMIN_PASSWORD оставьте пустым.
ADMIN_PASSWORD_HASH=

# --- Письма с кодами (подтверждение почты, сброс пароля) ----------------------------------
# Gmail: SMTP_USER — адрес, SMTP_PASSWORD — «пароль приложения»
# (аккаунт Google → Безопасность → Двухэтапная аутентификация → Пароли приложений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# ← ОБЯЗАТЕЛЬНО
SMTP_USER=
# ← ОБЯЗАТЕЛЬНО
SMTP_PASSWORD=
SMTP_FROM=K-Beauty | C-Health <shop@gmail.com>
SMTP_TLS=true
# с каких почт можно регистрироваться (через запятую), пусто — с любых. Пример: gmail.com,mail.ru
ALLOWED_EMAIL_DOMAINS=

# --- Оплата (подробно — docs/10-Оплата.md) ------------------------------------------------
# способы через запятую: kaspi_transfer (перевод на Kaspi), cash (при получении), kaspi_pay (Kaspi Pay API),
# test_card и test_kaspi — ТЕСТОВАЯ оплата картой и через Kaspi (имитация, деньги не списываются).
# Когда подключите настоящий эквайринг или Kaspi Pay, уберите test_card и test_kaspi из списка.
PAYMENT_METHODS=kaspi_transfer,cash,test_card,test_kaspi
# перевод на Kaspi: номер Kaspi Gold владельца и имя получателя (их видит покупатель после заказа)
# ← ОБЯЗАТЕЛЬНО для kaspi_transfer
KASPI_PHONE=+7 700 000 00 00
# ← ОБЯЗАТЕЛЬНО для kaspi_transfer
KASPI_RECEIVER=Имя Ф.
# ссылка Kaspi Pay / QR для оплаты в один клик (необязательно)
KASPI_PAY_LINK=
# Kaspi Pay для бизнеса — когда магазин получит доступ к API. Уведомления: https://<DOMAIN>/api/payments/kaspi/webhook
KASPI_API_URL=https://kaspi.kz/pay/api
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=

# --- Доставка (тенге) -------------------------------------------------------------------------
FREE_SHIPPING_FROM=15000
COURIER_PRICE=1000

# --- Дополнительно (обычно не трогать) ----------------------------------------------------------
# сколько дней действует вход на сайт
SESSION_DAYS=30
# ограничения частоты запросов с одного IP: вход, письма с кодами, регистрации, заказы/отзывы, все запросы
RATE_LOGIN=10/minute
RATE_LOGIN_EMAIL=5/minute
RATE_CODES=5/minute
RATE_REGISTER=5/hour
RATE_WRITE=60/minute
RATE_GLOBAL=300/minute
# число процессов API (≈ ядра процессора)
WEB_CONCURRENCY=2
# документация API /api/docs (в production по умолчанию выключена)
DOCS_ENABLED=false
